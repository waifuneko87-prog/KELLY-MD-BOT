# KELLY-MD configuration
BOT_NAME=KELLY-MD
BOT_OWNER=Sonali
OWNER_NUMBER=
PACKNAME=KELLY-MD
PACK_AUTHOR=Sonali
BOT_DESCRIPTION=Keep Running! KIRIKO!
BOT_VERSION=2.0.0
COMMAND_MODE=public

# ===== SESSION (choose one) =====
# Option 1: paste the full session string here
# SESSION_ID=KELLY-MD~eyJ...
# Option 2: put the string in a file named "session" in the bot root
# (recommended for panels)

SESSION_DIR=./session
SESSION_PREFIX=KELLY-MD

# Pairing website (run separately with: npm run pair)
PAIRING_PORT=3000
PAIRING_HOST=0.0.0.0
PAIRING_SESSIONS_DIR=temp_sessions
MAX_ACTIVE_SESSIONS=20
PAIRING_RATE_WINDOW_MS=600000
PAIRING_RATE_LIMIT=5
PAIRING_PENDING_TTL_MS=600000

# Legacy local pairing (optional, for development only)
PAIRING_CODE=false
PAIRING_NUMBER=

# APIs
GIPHY_API_KEY=
PEXELS_API_KEY=
XTEAM_API_KEY=
LOLHUMAN_API_KEY=
NEOXR_API_KEY=
VIOLETICS_API_KEY=
ZENZAPIS_API_KEY=
FGMODS_API_KEY=

# Optional updater URL
UPDATE_ZIP_URL=
